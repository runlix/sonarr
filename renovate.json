{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "mergeConfidence:all-badges",
    "config:recommended"
  ],

  "enabledManagers": ["custom.regex"],
  "baseBranches": ["nightly", "release"],

  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  /* override to silence the migrated invalid field */
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "digestMode": null
    },
    {
      "matchDatasources": ["docker"],
      "groupName": "docker-digest updates"
    },
    {
      "matchDatasources": ["github-releases"],
      "groupName": "sonarr version bump"
    }
  ],

  "docker": {
    "pinDigests": true,
    "digestMode": "auto"
  },

  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION\\.json$/"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "matchStrings": [
        "\"builder\":\\s*\\{[\\s\\S]*?\"image\":\\s*\"(?<depName>.*?)\",[\\s\\S]*?\"tag\":\\s*\"(?<currentValue>.*?)\",[\\s\\S]*?\"digest\":\\s*\"(?<currentDigest>sha256:[a-f0-9]{64})\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION\\.json$/"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "matchStrings": [
        "\"base\":\\s*\\{[\\s\\S]*?\"image\":\\s*\"(?<depName>.*?)\",[\\s\\S]*?\"tag\":\\s*\"(?<currentValue>.*?)\",[\\s\\S]*?\"digest\":\\s*\"(?<currentDigest>sha256:[a-f0-9]{64})\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION\\.json$/"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{org}}/{{repo}}",
      "versioningTemplate": "semver",
      "matchStrings": [
        "\"package_url\":\\s*\"https://github.com/(?<org>[^/]+)/(?<repo>[^/]+)/releases/download/v(?<currentValue>[^/]+)/Sonarr\\.main\\.(?<currentVersion>[^/]+)\\.linux-(?<arch>[^.]+)\\.tar\\.gz\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION\\.json$/"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Sonarr/Sonarr",
      "versioningTemplate": "semver",
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>.*?)\""
      ]
    }
  ]
}
