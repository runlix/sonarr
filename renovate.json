{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],

  /* renovate applies PRs only here */
  "baseBranches": ["nightly", "release"],

  /* reduce noise */
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  /* group related updates */
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "groupName": "docker-digest updates"
    },
    {
      "matchDatasources": ["github-releases"],
      "groupName": "sonarr version bump"
    }
  ],

  /* keep pinned digests deterministic */
  "docker": {
    "pinDigests": true,
    "digestMode": "auto"
  },

  /* ---- UPDATE PATHS FROM config.json → VERSION.json ---- */
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION\\.json$/"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "matchStrings": [
        "\"builder\":\\s*\\{[\\s\\S]*?\"image\":\\s*\"(?<depName>.*?)\",[\\s\\S]*?\"tag\":\\s*\"(?<currentValue>.*?)\",[\\s\\S]*?\"digest\":\\s*\"(?<currentDigest>sha256:[a-f0-9]{64})\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION\\.json$/"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "matchStrings": [
        "\"base\":\\s*\\{[\\s\\S]*?\"image\":\\s*\"(?<depName>.*?)\",[\\s\\S]*?\"tag\":\\s*\"(?<currentValue>.*?)\",[\\s\\S]*?\"digest\":\\s*\"(?<currentDigest>sha256:[a-f0-9]{64})\""
      ]
    },
    {
      /* Sonarr package_url bump */
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION\\.json$/"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{org}}/{{repo}}",
      "versioningTemplate": "semver",
      "matchStrings": [
        "\"package_url\":\\s*\"https://github.com/(?<org>[^/]+)/(?<repo>[^/]+)/releases/download/v(?<currentValue>[^/]+)/Sonarr\\.main\\.(?<currentVersion>[^/]+)\\.linux-(?<arch>[^.]+)\\.tar\\.gz\""
      ]
    },
    {
      /* update root "version" key */
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION\\.json$/"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Sonarr/Sonarr",
      "versioningTemplate": "semver",
      "matchStrings": [
        "\"version\":\\s*\"(?<currentValue>.*?)\""
      ]
    }
  ]
}
